# Racine du site sur l'hébergement mutualisé.
# Tout passe par le dossier public/ ; le code, la configuration
# et les fichiers déposés ne sont jamais servis directement.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dossiers internes : accès refusé.
    RewriteRule ^(app|bin|config|database|resources|storage|tests)(/.*)?$ - [F,L]

    # Fichiers cachés (.git, .env, .editorconfig…) : accès refusé.
    RewriteRule (^|/)\. - [F,L]

    # Tout le reste est servi depuis public/.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "\.(md|sql|lock|json|xlsx|xls|csv|pdf|log|example)$">
    Require all denied
</FilesMatch>
