Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fichiers cachés (.htaccess…) : accès refusé.
    RewriteRule (^|/)\. - [F,L]

    # Les fichiers existants (CSS, JS, polices, images) sont servis tels quels.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Toutes les autres adresses passent par le contrôleur frontal.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    <FilesMatch "\.(css|js|woff2|svg|jpe?g|png|webp|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# Compression : AddOutputFilterByType vient de mod_filter. Sans cette garde,
# un hébergement qui charge mod_deflate sans mod_filter renverrait une erreur 500.
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
    </IfModule>
</IfModule>

<Files ".ht*">
    Require all denied
</Files>

AddType font/woff2 .woff2
AddType image/svg+xml .svg
